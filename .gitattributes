# Auto detect text files and perform LF normalization
* text=auto
* text eol=lf

# ===
# Binary Files (don't diff, don't fix line endings)
# ===

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tiff binary
*.png binary

# Data and model artifacts (must not be line-ending normalized)
*.npy binary
*.npz binary
*.gz binary
*.zip binary
*.xlsx binary
*.pdf binary
*.svg binary
*.h5 binary
*.rds binary
*.gmt binary
